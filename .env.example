# Copy this file to .env and fill in your keys. .env is git-ignored.

# Required for Tier 1+
ANTHROPIC_API_KEY=

# Optional — override the default model (see jeet/config.py)
# JEET_MODEL=claude-opus-5

# Required for voice mode (Tier 3): python -m jeet.voice
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# Pick a voice at https://elevenlabs.io/app/voice-library and copy its ID
ELEVENLABS_VOICE_ID=

# Optional — override the STT/TTS models (see jeet/config.py)
# JEET_STT_MODEL=nova-3
# JEET_TTS_MODEL=eleven_flash_v2_5
